{
    "name": "agentic-code-box",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": false,
            "configureZsh": false,
            "username": "vscode",
            "uid": "1000",
            "gid": "1000"
        },
        "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server": "1.0.3",
        "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge": "1.0.1",
        "ghcr.io/nmwael/agentic-devcontainer-feature/models": "1.3.0",
        "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway": "1.1.1",
        "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents": "1.2.2",
        "ghcr.io/devcontainers-extra/features/opencode": {
            "version": "latest"
        },
        "ghcr.io/tailscale/codespace/tailscale": {
            "version": "latest"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages": {
            "version": "1",
            "packages": "gh,jq,ripgrep,shfmt,bats,python3,python3-pip,python3-venv"
        }
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/common-utils:2",
        "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server",
        "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge",
        "ghcr.io/nmwael/agentic-devcontainer-feature/models",
        "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway",
        "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents",
        "ghcr.io/devcontainers-extra/features/opencode",
        "ghcr.io/tailscale/codespace/tailscale",
        "ghcr.io/devcontainers-extra/features/apt-get-packages"
    ],
    "runArgs": [
        "--device=nvidia.com/gpu=all",
        "--shm-size=2g",
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp:unconfined"
    ],
    "forwardPorts": [
        8082,
        8089,
        8090,
        4096
    ],
    "containerEnv": {
        "TS_AUTHKEY": "${localEnv:TS_AUTHKEY}",
        "TS_HOSTNAME": "${localEnv:TS_HOSTNAME}",
        "SKIP_LLAMA_START": "${localEnv:SKIP_LLAMA_START}"
    },
    "postCreateCommand": "bash scripts/post-create.sh",
    "postStartCommand": "bash scripts/auto-startup.sh"
}
